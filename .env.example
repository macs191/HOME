# Supabase — مفاتيح الواجهة العامة فقط
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# اختياري: مزود خرائط للبحث ووقت القيادة عبر الخادم/Edge Function
VITE_MAPS_PROVIDER=

# اختياري: Google Places Autocomplete — استخدم مفتاحًا مقيدًا بالنطاق مع تفعيل Places API
VITE_GOOGLE_MAPS_API_KEY=

# Google Sign-In الأصلي في Android: Web OAuth client ID من Google Cloud
VITE_GOOGLE_WEB_CLIENT_ID=

# روابط التوزيع الرسمية بعد رفع APK أو نشر App Store/TestFlight
VITE_ANDROID_DOWNLOAD_URL=
VITE_IOS_DOWNLOAD_URL=

# إذا لم تُمرر هذه القيم أثناء البناء، يستخدم التطبيق إعدادات Supabase/Google العامة المضمّنة في HOME.
